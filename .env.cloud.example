# EventFund OS cloud runtime.
# Paper trading is the default and should remain default for first cloud launch.

NODE_ENV=production
EVENTFUND_DEPLOY_TARGET=cloud
EVENTFUND_ENV=production
TRADING_MODE=paper
ENABLE_LIVE_TRADING=false
GLOBAL_KILL_SWITCH=false
ALLOW_DEMO_MARKETS=false

# Managed Redis or Redis Stack. Required for paper execution, portfolio state, audit, queues, and policy mutation.
REDIS_URL=rediss://default:REPLACE_ME@REPLACE_ME:6379
REDIS_NAMESPACE=efos

# Kalshi. Required for real market data/authenticated account paths. Use demo base URL until production approval.
KALSHI_BASE_URL=https://external-api.demo.kalshi.co/trade-api/v2
KALSHI_API_KEY=REPLACE_ME
KALSHI_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nREPLACE_ME\n-----END PRIVATE KEY-----"

# Weave / W&B. Mandatory observability integration.
WANDB_API_KEY=REPLACE_ME
WANDB_ENTITY=REPLACE_ME
WEAVE_PROJECT=eventfund-os-cloud
WANDB_PROJECT=eventfund-os-cloud
WEAVE_DISABLED=false

# Free model path for CopilotKit in cloud requires a reachable Ollama service.
# Do not use localhost unless Ollama is in the same container, which is not recommended.
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=https://REPLACE_WITH_OLLAMA_SERVICE/v1
OLLAMA_MODEL=qwen2.5:3b
OLLAMA_API_KEY=ollama
COPILOTKIT_TELEMETRY_DISABLED=true

# Optional CopilotKit license/cloud key.
NEXT_PUBLIC_COPILOTKIT_LICENSE_KEY=
NEXT_PUBLIC_COPILOTKIT_API_KEY=

# Live trading remains blocked unless all explicit live variables below are set intentionally.
MAX_DAILY_LOSS=1000
MAX_WEEKLY_LOSS=3000
MAX_POSITION_SIZE=250
MAX_SECTOR_EXPOSURE=1000
MAX_CORRELATED_EXPOSURE=1500
MAX_OPEN_ORDERS=20
MAX_SLIPPAGE_BPS=10000
MIN_LIQUIDITY=1
MIN_CONFIDENCE=0.35
MIN_EVIDENCE_QUALITY=0.4
MAX_RULE_AMBIGUITY=0.6
MAX_DRAWDOWN=2000
KELLY_FRACTION=0.25
RISK_AGENT_MAX_POSITION_SIZE=50
RISK_AGENT_TARGET_SECTOR_EXPOSURE=250
RISK_AGENT_TARGET_LIQUIDITY=100
RISK_AGENT_TARGET_CONFIDENCE=0.62
RISK_AGENT_TARGET_SLIPPAGE_BPS=150
RISK_AGENT_MAX_RISK_SCORE=65
PAPER_AGENT_MAX_TRADES_PER_CYCLE=5
PAPER_AGENT_MIN_CYCLE_SCORE=0
