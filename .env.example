# EventFund OS defaults to paper mode.
TRADING_MODE=paper
ENABLE_LIVE_TRADING=false
GLOBAL_KILL_SWITCH=false
ALLOW_DEMO_MARKETS=false

# Kalshi: public market data works without auth; these are required for account reads and live operations.
KALSHI_BASE_URL=https://external-api.demo.kalshi.co/trade-api/v2
KALSHI_API_KEY=
KALSHI_PRIVATE_KEY=
# Alternative if you mount a key file locally:
KALSHI_PRIVATE_KEY_PATH=
# Accepted alias for legacy naming, but Kalshi uses an RSA private key.
KALSHI_API_SECRET=

# Redis: mandatory for coordination, idempotency, paper execution state, and agent queues.
REDIS_URL=redis://localhost:6379
REDIS_NAMESPACE=efos
EVENTFUND_ENV=dev
OPERATOR_API_TOKEN=

# Weave from W&B: mandatory observability integration, disabled only when credentials are missing.
WANDB_API_KEY=
WANDB_ENTITY=
WANDB_PROJECT=eventfund-os-dev
WEAVE_PROJECT=eventfund-os-dev
WEAVE_DISABLED=false

# CopilotKit runtime. Default is free local Ollama, no OpenAI key required.
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=qwen2.5:3b
OLLAMA_API_KEY=ollama
NEXT_PUBLIC_COPILOTKIT_LICENSE_KEY=
NEXT_PUBLIC_COPILOTKIT_API_KEY=

# Optional paid fallback: set LLM_PROVIDER=openai and provide these.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
COPILOTKIT_TELEMETRY_DISABLED=true

# Risk limits required before live trading can activate.
MAX_DAILY_LOSS=1000
MAX_WEEKLY_LOSS=3000
MAX_POSITION_SIZE=250
MAX_SECTOR_EXPOSURE=1000
MAX_CORRELATED_EXPOSURE=1500
MAX_OPEN_ORDERS=20
MAX_SLIPPAGE_BPS=10000
MIN_LIQUIDITY=1
MIN_CONFIDENCE=0.35
MIN_EVIDENCE_QUALITY=0.4
MAX_RULE_AMBIGUITY=0.6
MAX_DRAWDOWN=2000
KELLY_FRACTION=0.25

# Risk Agent target policy. These are negotiated preferences, not global kill-switch rails.
RISK_AGENT_MAX_POSITION_SIZE=50
RISK_AGENT_TARGET_SECTOR_EXPOSURE=250
RISK_AGENT_TARGET_LIQUIDITY=100
RISK_AGENT_TARGET_CONFIDENCE=0.62
RISK_AGENT_TARGET_SLIPPAGE_BPS=150
RISK_AGENT_MAX_RISK_SCORE=65

# Agent paper-cycle policy. Low score threshold keeps early paper volume flowing.
PAPER_AGENT_MAX_TRADES_PER_CYCLE=5
PAPER_AGENT_MIN_CYCLE_SCORE=0

# Continuous paper daemon and agent learning.
PAPER_DAEMON_ENABLED=false
PAPER_DAEMON_INTERVAL_MS=300000
PAPER_DAEMON_MAX_TICKS=1
AGENT_POLICY_AUTOPILOT_APPLY=false
