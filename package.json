{
  "name": "eventfund-os",
  "version": "0.1.0",
  "private": true,
  "description": "EventFund OS: a production-minded multi-agent Kalshi event trading command center.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:local": "EVENTFUND_DEPLOY_TARGET=local next build",
    "build:cloud": "EVENTFUND_DEPLOY_TARGET=cloud next build",
    "start": "next start",
    "lint": "eslint . --ext .ts,.tsx",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "smoke": "node scripts/smoke-test.mjs",
    "check:env": "node scripts/check-env.mjs",
    "cloud:preflight": "node scripts/cloud-preflight.mjs",
    "daemon:paper": "node scripts/paper-daemon.mjs",
    "docker:build": "docker build -t eventfund-os .",
    "qa": "npm run typecheck && npm run test && npm run smoke"
  },
  "dependencies": {
    "@ai-sdk/openai": "^3.0.68",
    "@copilotkit/react-core": "latest",
    "@copilotkit/react-ui": "latest",
    "@copilotkit/runtime": "latest",
    "ai": "^6.0.197",
    "lucide-react": "latest",
    "next": "^16.2.7",
    "openai": "^6.42.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "redis": "^4.7.0",
    "server-only": "^0.0.1",
    "weave": "latest",
    "zod": "^3.25.0"
  },
  "overrides": {
    "next": {
      "postcss": "^8.5.15"
    },
    "prismjs": "^1.30.0",
    "uuid": "^11.1.1"
  },
  "devDependencies": {
    "@types/node": "^20.17.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "autoprefixer": "^10.4.20",
    "eslint": "^8.57.1",
    "eslint-config-next": "14.2.25",
    "postcss": "^8.5.15",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.0",
    "vitest": "^2.1.8"
  }
}
